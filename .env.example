# Copy this file to .env and fill in real values. Never commit .env.

# Database
DB_URL=jdbc:postgresql://localhost:5432/hisync
DB_USERNAME=postgres
DB_PASSWORD=

# Gmail account used to send password-reset codes (use a Google "App password")
MAIL_USERNAME=
MAIL_PASSWORD=

# YouTube Data API key
YOUTUBE_API_KEY=

# Secret used to sign login tokens. At least 32 characters, random.
# Generate one in PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=
JWT_EXPIRATION_HOURS=24
